{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Schéma pour l'exercice de dictée",
    "description": "Définit la structure attendue pour une dictée et ses explications",
    "type": "object",
    "properties": {
        "dictee": {
            "type": "object",
            "properties": {
                "texte": {
                    "type": "string",
                    "description": "Le texte complet de la dictée"
                },
                "titre": {
                    "type": "string",
                    "description": "Le titre de la dictée"
                },
                "mots_cles": {
                    "type": "array",
                    "description": "Liste des mots clés demandés qui apparaissent dans la dictée",
                    "items": {
                        "type": "string"
                    }
                },
                "explications": {
                    "type": "array",
                    "description": "Explications sur les points grammaticaux et orthographiques importants",
                    "items": {
                        "type": "object",
                        "properties": {
                            "point": {
                                "type": "string",
                                "description": "Point grammatical ou orthographique expliqué"
                            },
                            "explication": {
                                "type": "string",
                                "description": "Explication détaillée du point grammatical ou orthographique"
                            },
                            "exemples": {
                                "type": "array",
                                "description": "Exemples tirés de la dictée illustrant ce point",
                                "items": {
                                    "type": "string"
                                }
                            }
                        },
                        "required": ["point", "explication"]
                    }
                }
            },
            "required": ["texte", "titre", "explications"]
        }
    },
    "required": ["dictee"]
}

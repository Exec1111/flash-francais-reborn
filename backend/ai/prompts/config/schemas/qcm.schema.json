{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "titre": {
      "type": "string",
      "minLength": 5,
      "maxLength": 80,
      "description": "Titre clair et concis du QCM"
    },
    "description": {"type": "string"},
    "niveau": {"type": "string", "enum": ["6ème faible", "6ème", "6ème élevé", "5ème faible", "5ème", "5ème élevé", "4ème faible", "4ème", "4ème élevé", "3ème faible", "3ème", "3ème élevé"]},
    "theme": {"type": "string"},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": ["integer", "string"]},
          "texte": {"type": "string"},
          "reponse_correcte": {"type": "string", "description": "ID de l'option qui est la bonne réponse"},
          "explication": {"type": "string", "description": "Explication de la réponse correcte (optionnel)"},
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "string"},
                "texte": {"type": "string"}
              },
              "required": ["id", "texte"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "texte", "options", "reponse_correcte"],
        "additionalProperties": false
      }
    }
  },
  "required": ["titre", "niveau", "theme", "questions"],
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LeconComplete1",
  "description": "Schema pour une leçon complète structurée.",
  "type": "object",
  "properties": {
    "lesson_topic_category": {
      "type": "string",
      "description": "Catégorie ou type de la leçon (ex: Leçon d'Histoire, Leçon de Grammaire)."
    },
    "title": {
      "type": "string",
      "description": "Titre principal de la leçon."
    },
    "subtitle": {
      "type": "string",
      "description": "Sous-titre ou description brève de la leçon."
    },
    "sections": {
      "type": "array",
      "description": "Contenu principal de la leçon, divisé en sections.",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "description": "Titre de la section."
          },
          "content_type": {
            "type": "string",
            "enum": ["paragraph", "list"],
            "description": "Type de contenu pour cette section (paragraphe ou liste)."
          },
          "paragraphs": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Liste de paragraphes pour la section (utilisé si content_type est 'paragraph')."
          },
          "list_items": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Liste d'éléments pour la section (utilisé si content_type est 'list')."
          }
        },
        "required": ["heading", "content_type"]
      }
    },
    "examples_section": {
      "type": "object",
      "description": "Section pour les exemples.",
      "properties": {
        "heading": {
          "type": "string",
          "description": "Titre de la section exemples (ex: Exemples de découvertes archéologiques)."
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {"type": "string"}
            },
            "required": ["description"]
          }
        }
      },
      "required": ["heading", "examples"]
    },
    "attention_section": {
      "type": "object",
      "description": "Section pour les points d'attention.",
      "properties": {
        "heading": {
          "type": "string",
          "description": "Titre de la section attention (ex: Attention !)."
        },
        "points": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["heading", "points"]
    },
    "summary_section": {
      "type": "object",
      "description": "Section pour le résumé / à retenir.",
      "properties": {
        "heading": {
          "type": "string",
          "description": "Titre de la section résumé (ex: À retenir)."
        },
        "points": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["heading", "points"]
    },
    "highlight_keywords": {
        "type": "array",
        "description": "Liste des mots-clés importants à mettre en évidence dans le texte.",
        "items": {
            "type": "string"
        }
    }
  },
  "required": [
    "lesson_topic_category",
    "title",
    "subtitle",
    "sections",
    "highlight_keywords"
  ]
}
